{
  "name": "backend-autopilot",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "bootstrap": "pnpm install && pnpm exec playwright install chromium && pnpm autopilot health",
    "dev": "concurrently -k -n api,console -c blue,green \"pnpm dev:api\" \"pnpm dev:console\"",
    "dev:api": "tsx apps/control-api/src/main.ts",
    "dev:console": "pnpm --dir apps/operator-console dev",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "deployment:export-state": "tsx scripts/export-deployment-state.ts",
    "deployment:bootstrap": "tsx scripts/deployment-bootstrap.ts",
    "execution:job": "tsx scripts/run-execution-job.ts",
    "epic:verify": "tsx scripts/run-epic-verification.ts",
    "remote:e2e": "tsx scripts/remote-e2e.ts",
    "pages:e2e": "tsx scripts/pages-e2e.ts",
    "superadmin:remote:e2e": "tsx scripts/superadmin-remote-e2e.ts",
    "superadmin:kotlin:remote:e2e": "tsx scripts/superadmin-kotlin-remote-e2e.ts",
    "oauth:consent:e2e": "tsx scripts/oauth-consent-e2e.ts",
    "mcp:health-check": "tsx scripts/mcp-health-check.ts",
    "oauth:configure": "tsx scripts/configure-oauth-server.ts",
    "resource:register-self": "tsx scripts/register-self-resource.ts",
    "mcp": "tsx apps/mcp-server/src/main.ts",
    "autopilot": "tsx apps/cli/src/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "state:migrate:remote": "tsx scripts/migrate-file-state.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "vitest run tests/e2e",
    "live:sandbox": "tsx scripts/live-sandbox.ts",
    "build:core": "tsc -p tsconfig.build.json",
    "build:console": "pnpm --dir apps/operator-console build",
    "build": "pnpm build:core && pnpm build:console",
    "console:e2e:seed": "tsx scripts/seed-console-e2e.ts",
    "test:browser": "pnpm console:e2e:seed && playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm typecheck:edge && pnpm test && pnpm build && pnpm test:browser",
    "typecheck:edge": "deno check --no-lock --config supabase/functions/mcp/deno.json supabase/functions/mcp/index.ts && deno check --no-lock --config supabase/functions/control-api/deno.json supabase/functions/control-api/index.ts && deno check --no-lock --config supabase/functions/reconcile/deno.json supabase/functions/reconcile/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.3",
    "commander": "^14.0.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.4",
    "fastify": "^5.5.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "yaml": "^2.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "concurrently": "10.0.5",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
