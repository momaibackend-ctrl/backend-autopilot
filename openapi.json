{
  "openapi": "3.0.3",
  "info": {
    "title": "Backend Autopilot -- Deterministic Task Execution Contract",
    "version": "0.5.0",
    "description": "Machine-readable contracts for Backend Autopilot deterministic task execution and Operator Console authentication."
  },
  "paths": {
    "/functions/v1/mcp": {
      "post": {
        "summary": "JSON-RPC 2.0 tools/call -- superadmin_task_execute",
        "description": "Queues a fixed GitHub Actions execution using a registered resource ID and semantic file changes. operationId is mandatory and globally replay-safe: repeating an already-used operationId for the same tool/project never redispatches -- it returns the existing execution's status only.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolCallRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Either an accepted deterministic execution or a structured DomainError. Both are always well-formed JSON-RPC results; HTTP 200 does not by itself imply success -- inspect isError.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/DeterministicExecutionToolResult"
                    },
                    {
                      "$ref": "#/components/schemas/DomainErrorToolResult"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/functions/v1/control-api/v1/auth/login": {
      "post": {
        "summary": "Create an Operator Console session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsoleLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed console-only session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsoleSession"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/functions/v1/control-api/v1/auth/session": {
      "get": {
        "summary": "Validate an Operator Console session",
        "security": [
          {
            "ConsoleBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Active session"
          },
          "401": {
            "description": "Invalid or expired session"
          },
          "403": {
            "description": "Operator disabled"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ToolCallRequest": {
        "type": "object",
        "required": ["jsonrpc", "method", "params"],
        "properties": {
          "jsonrpc": {"type": "string", "enum": ["2.0"]},
          "id": {"type": "string"},
          "method": {"type": "string", "enum": ["tools/call"]},
          "params": {
            "type": "object",
            "required": ["name", "arguments"],
            "properties": {
              "name": {"type": "string", "enum": ["superadmin_task_execute"]},
              "arguments": {
                "type": "object",
                "required": ["operationId", "projectId", "taskId", "resourceId", "changes"],
                "properties": {
                  "operationId": {"type": "string", "minLength": 8, "maxLength": 200},
                  "projectId": {"type": "string", "format": "uuid"},
                  "taskId": {"type": "string", "format": "uuid"},
                  "resourceId": {"type": "string", "format": "uuid"},
                  "changes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["path", "content"],
                      "properties": {"path": {"type": "string"}, "content": {"type": "string"}}
                    }
                  }
                }
              }
            }
          }
        }
      },
      "DeterministicExecutionResult": {
        "type": "object",
        "required": ["status", "jobId", "runId", "mode", "job", "run", "idempotentReplay"],
        "properties": {
          "status": {"type": "string", "enum": ["EXECUTION_ACCEPTED"]},
          "jobId": {"type": "string", "format": "uuid"},
          "runId": {"type": "string", "format": "uuid"},
          "mode": {"type": "string", "enum": ["DISPATCHED", "STATUS_ONLY"]},
          "job": {"$ref": "#/components/schemas/ExecutionJobSummary"},
          "run": {"$ref": "#/components/schemas/RunSummary"},
          "idempotentReplay": {"type": "boolean"}
        }
      },
      "ExecutionJobSummary": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "status": {"type": "string"},
          "branch": {"type": "string"}
        }
      },
      "RunSummary": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "status": {"type": "string"}
        }
      },
      "DomainErrorToolResult": {
        "type": "object",
        "required": ["isError", "content"],
        "properties": {
          "isError": {"type": "boolean", "enum": [true]},
          "content": {"type": "array", "items": {"type": "object"}}
        }
      },
      "BlockingReport": {
        "type": "object",
        "required": ["code", "reason", "remediation"],
        "properties": {
          "code": {"type": "string"},
          "reason": {"type": "string"},
          "remediation": {"type": "string"}
        }
      },
      "ConsoleLoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": {"type": "string"},
          "password": {"type": "string", "format": "password", "writeOnly": true}
        }
      },
      "ConsoleSession": {
        "type": "object",
        "required": ["token", "expiresAt", "user"],
        "properties": {
          "token": {"type": "string", "writeOnly": true},
          "expiresAt": {"type": "string", "format": "date-time"},
          "user": {
            "type": "object",
            "required": ["login", "role"],
            "properties": {
              "login": {"type": "string"},
              "role": {"type": "string", "enum": ["SUPERADMIN"]}
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ConsoleBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "BackendAutopilotConsoleSession"
      }
    }
  }
}
