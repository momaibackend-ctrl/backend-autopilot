# Optional external PostgreSQL control-plane state. Docker is not required.
# DATABASE_URL=postgresql://...
AUTOPILOT_HOST=127.0.0.1
AUTOPILOT_PORT=4310
AUTOPILOT_LOG_LEVEL=info
AUTOPILOT_STATE_PATH=./.autopilot/state.json
AUTOPILOT_WORKSPACE_ROOT=./workspaces
AUTOPILOT_ARTIFACT_ROOT=./artifacts

# Provider-neutral public container/gateway. These are URLs, not secrets. The
# stable public URL is owned by DNS; changing a server only changes its A/AAAA record.
# AUTOPILOT_PUBLIC_BASE_URL=https://backend.example.com
# AUTOPILOT_UPSTREAM_MCP_URL=https://<project-ref>.supabase.co/functions/v1/mcp
# AUTOPILOT_UPSTREAM_CONTROL_API_URL=https://<project-ref>.supabase.co/functions/v1/control-api
# AUTOPILOT_OAUTH_AUTHORIZATION_SERVER_URL=https://<project-ref>.supabase.co/auth/v1
# AUTOPILOT_UPSTREAM_TIMEOUT_MS=120000

# Explicit local-development proxy only. Production is a static export and
# calls the authenticated Supabase Edge URL compiled by the Pages workflow.
# AUTOPILOT_CONTROL_API_ORIGIN=http://127.0.0.1:4310
# NEXT_PUBLIC_AUTOPILOT_LOCAL_DEV=true

# Remote references (values belong in Supabase Edge / GitHub Actions secrets).
# AUTOPILOT_CONTROL_SUPABASE_URL=https://<project-ref>.supabase.co
# AUTOPILOT_CONTROL_SUPABASE_PUBLISHABLE_KEY=
# AUTOPILOT_CONTROL_SUPABASE_SERVICE_ROLE_KEY=
# AUTOPILOT_GITHUB_TOKEN=
# AUTOPILOT_MCP_TOKEN=
# AUTOPILOT_SUPERADMIN_MCP_TOKEN=
# AUTOPILOT_SUPERADMIN_MCP_ACTOR=<stable-audited-service-principal>
# AUTOPILOT_SYSTEM_PROJECT_ID=<control-plane-project-uuid>
# AUTOPILOT_RECONCILE_TOKEN=

# Runtime values are created/updated by secret providers and never documented here.
# SUPABASE_ACCESS_TOKEN=
# AUTOPILOT_SUPABASE_HOME=.autopilot/supabase-home
# AUTOPILOT_SUPABASE_ACCESS_TOKEN_REF=AUTOPILOT_<PROJECT>_SUPABASE_ACCESS_TOKEN
# AUTOPILOT_GITHUB_SANDBOX_LOGIN=<dedicated-sandbox-login>
# AUTOPILOT_GITHUB_SANDBOX_REPOSITORY=<owner/name>
# AUTOPILOT_SUPABASE_SANDBOX_PROJECT_REF=<20-letter-project-ref>
# AUTOPILOT_CONFIRM_DEDICATED_SANDBOX=false
# AUTOPILOT_CONFIRM_SUPABASE_CREDENTIAL_ROTATION=false
# AUTOPILOT_<PROJECT>_DATABASE_URL=
